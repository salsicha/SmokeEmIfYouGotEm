#pragma once
#include "/Plugin/RaftSimWaterDetail/Private/RaftSimLiquidPhysicalFrame.ush"

// Finish an ALREADY prescribed inlet-plane displacement in the native float
// position representation. A tangential move on a rotated plane generally has
// no exactly representable endpoint. Select the nearest inward representable
// dominant component, instead of allowing roundoff to accumulate outwards.
// Only roundoff residual from the prior normal projection is corrected here.
// This is not an exit-classifier tolerance or an extension of the physical box.
float3 RaftSimLiquidPrescribedNormalPosition(float3 start,float3 candidate,float3 inwardNormal,float travel)
{
    int axis=abs(inwardNormal.x)>=abs(inwardNormal.y)?0:1;
    FDFScalar actual=RaftSimLiquidPhysicalDot(DFTwoSum(candidate,-start),inwardNormal);
    FDFScalar residual=DFSubtract(actual,travel);
    float corrected=DFDemote(DFSubtract(DFPromote(candidate[axis]),DFDivide(residual,inwardNormal[axis])));
    // FXC cannot address a vector component through a variable l-value. Keep
    // the same dominant-axis arithmetic and store only that named component.
    if(axis==0) candidate.x=corrected; else candidate.y=corrected;
    actual=RaftSimLiquidPhysicalDot(DFTwoSum(candidate,-start),inwardNormal);
    if(DFLess(actual,travel))
    {
        float value=candidate[axis];
        if(value==0) corrected=inwardNormal[axis]>0 ? asfloat(0x00800000u):-asfloat(0x00800000u);
        else corrected=asfloat(asuint(value)+((value>0)==(inwardNormal[axis]>0)?1u:0xffffffffu));
        if(axis==0) candidate.x=corrected; else candidate.y=corrected;
    }
    return candidate;
}
