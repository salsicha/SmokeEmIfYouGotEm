#include "/Engine/Public/Platform.ush"
#include "RaftSimPressureMath.ush"
int2 GridSize;
float CellMeters;
uint Periodic;
float2 Lengths;
float2 PoleWeights;
StructuredBuffer<float4> State;
#if RAFTSIM_PRESSURE_BOUNDARY
StructuredBuffer<float2> BoundaryVelocity;
float2 BoundarySource(uint i)
{
    if(!RaftSimPressureWet(State[i].x))return 0;
    uint x=i%GridSize.x,y=i/GridSize.x;float2 source=0;
    if(x==0)source-=BoundaryVelocity[y]/CellMeters;
    if(x+1==GridSize.x)source+=BoundaryVelocity[GridSize.y+y]/CellMeters;
    if(y==0)source-=BoundaryVelocity[2*GridSize.y+x]/CellMeters;
    if(y+1==GridSize.y)source+=BoundaryVelocity[2*GridSize.y+GridSize.x+x]/CellMeters;
    return source;
}
#endif
StructuredBuffer<float4> HydroRate;
StructuredBuffer<float2> Geometry;
StructuredBuffer<uint> Pairs;
StructuredBuffer<float2> PhysicalBedSlope;
StructuredBuffer<float> NonbreakingFraction;
StructuredBuffer<float4> Correction;
StructuredBuffer<uint> SolverDiagnostics;
RWStructuredBuffer<float2> Velocity;
RWStructuredBuffer<float4> Terms;
RWStructuredBuffer<float2> Base;
RWStructuredBuffer<float4> Forcing;
RWStructuredBuffer<float2> BaseW;
RWStructuredBuffer<float4> RightHandSide;
RWStructuredBuffer<float4> Pressure;
RWStructuredBuffer<float2> Force;
RWStructuredBuffer<uint> Diagnostics;

uint Neighbor(uint i,int axis,int direction)
{
    int2 p=int2(i%GridSize.x,i/GridSize.x);
    p[axis]=(p[axis]+direction+GridSize[axis])%GridSize[axis];
    return p.y*GridSize.x+p.x;
}
float2 Weights(uint i,uint j)
{
    return RaftSimPressureWeights(Geometry[i].x,Geometry[j].x);
}
float2 Slope(uint i) { return RaftSimPressureWet(Geometry[i].x)?PhysicalBedSlope[i]:0; }
void Coefficients(uint i,out float2 center,out float4 edge)
{
    float h=Geometry[i].x;float2 b=Slope(i);center=0;edge=0;
    [unroll(2)]for(int a=0;a<2;++a)
    {
        uint r=Neighbor(i,a,1),l=Neighbor(i,a,-1);
        bool pr=(Pairs[i]&(1u<<a))!=0,pl=(Pairs[l]&(1u<<a))!=0;
        float2 wr=Weights(i,r),wl=Weights(i,l);
        float3 values=RaftSimPressureCoefficients(h,Geometry[r].x,Geometry[l].x,b[a],wr,wl,pr,pl,CellMeters);
        center[a]=values.x;edge[a]=values.y;edge[a+2]=values.z;
    }
}
float2 GradTerms(uint i,int component)
{
    float2 g=0;float v=Terms[i][component];
    [unroll(2)]for(int a=0;a<2;++a)
    {
        uint r=Neighbor(i,a,1),l=Neighbor(i,a,-1);
        if((Pairs[i]&(1u<<a))!=0)g[a]+=Weights(i,r).x*(Terms[r][component]-v)/CellMeters;
        if((Pairs[l]&(1u<<a))!=0)g[a]+=Weights(i,l).x*(v-Terms[l][component])/CellMeters;
    }
    return g;
}
float2 GradPressure(uint i,int component,bool forcing)
{
    float2 g=0;float v=forcing?Forcing[i][component]:Pressure[i][component];
    [unroll(2)]for(int a=0;a<2;++a)
    {
        uint r=Neighbor(i,a,1),l=Neighbor(i,a,-1);
        float vr=forcing?Forcing[r][component]:Pressure[r][component];
        float vl=forcing?Forcing[l][component]:Pressure[l][component];
        if((Pairs[i]&(1u<<a))!=0)g[a]=RaftSimPortableAdd(g[a],RaftSimPortableDivide(
            RaftSimPortableMul(Weights(i,r).x,RaftSimPortableSub(vr,v)),CellMeters));
        if((Pairs[l]&(1u<<a))!=0)g[a]=RaftSimPortableAdd(g[a],RaftSimPortableDivide(
            RaftSimPortableMul(Weights(i,l).x,RaftSimPortableSub(v,vl)),CellMeters));
    }
    return g;
}
float WeightRate(uint i,uint j)
{
    float2 w=Weights(i,j);float total=RaftSimPortableAdd(Geometry[i].x,Geometry[j].x);
    return RaftSimPressureWet(total)?RaftSimPortableDivide(RaftSimPortableSub(
        RaftSimPortableMul(HydroRate[i].x,w.y),RaftSimPortableMul(w.x,HydroRate[j].x)),total):0;
}
float2 WCorrection(uint i)
{
    float2 c;float4 e;Coefficients(i,c,e);float4 v=Correction[i];
    float2 w=float2(dot(c,v.xy),dot(c,v.zw));
    [unroll(2)]for(int a=0;a<2;++a)
    {
        float4 r=Correction[Neighbor(i,a,1)],l=Correction[Neighbor(i,a,-1)];
        w+=e[a]*float2(r[a],r[a+2])+e[a+2]*float2(l[a],l[a+2]);
    }
    return w;
}
[numthreads(256,1,1)]
void MainCS(uint3 id:SV_DispatchThreadID)
{
    uint i=id.x;if(i>=GridSize.x*GridSize.y)return;
#if RAFTSIM_PRESSURE_PHASE == 0
    float4 state=State[i];float2 g=Geometry[i];float f=NonbreakingFraction[i];
    bool invalid=any(!isfinite(state)) || any(!isfinite(g)) || any(!isfinite(HydroRate[i])) ||
        any(!isfinite(PhysicalBedSlope[i])) || !isfinite(f) || f<0 || f>1 ||
        !RaftSimPortableValidState(state) || RaftSimPressureNegative(g.x) ||
        (asuint(state.x)!=asuint(g.x) && ((asuint(state.x)|asuint(g.x))&0x7fffffffu)!=0) || (Pairs[i]&~3u)!=0;
    [unroll(2)]for(int a=0;a<2;++a)if((Pairs[i]&(1u<<a))!=0)
    {
        uint coord=a==0?i%GridSize.x:i/GridSize.x;
        invalid=invalid || GridSize[a]==1 || (Periodic==0 && coord+1==GridSize[a]) ||
            !RaftSimPressureWet(g.x) || !RaftSimPressureWet(Geometry[Neighbor(i,a,1)].x);
    }
    float2 u=RaftSimPressureWet(g.x)?RaftSimPressureDivide(state.yz,g.x):0;
    invalid=invalid || any(!isfinite(u));
    if(invalid){InterlockedAdd(Diagnostics[0],1);Velocity[i]=0;}else Velocity[i]=u;
#if RAFTSIM_PRESSURE_BOUNDARY
    for(uint j=i;j<2*(GridSize.x+GridSize.y);j+=GridSize.x*GridSize.y)
        if(any(!isfinite(BoundaryVelocity[j])))InterlockedAdd(Diagnostics[0],1);
#endif
#else
    if(Diagnostics[0]!=0 || Diagnostics[1]!=0)
    {
        // No invalid RHS/intermediate can be mistaken for a successful solve.
#if RAFTSIM_PRESSURE_PHASE == 4
        RightHandSide[i]=0;
#elif RAFTSIM_PRESSURE_PHASE == 5
        Pressure[i]=0;
#elif RAFTSIM_PRESSURE_PHASE == 6
        Force[i]=0;
#endif
        return;
    }
#if RAFTSIM_PRESSURE_PHASE == 1
    float2 u=Velocity[i],advective=0;float div=0;
    [unroll(2)]for(int a=0;a<2;++a)
    {
        uint r=Neighbor(i,a,1),l=Neighbor(i,a,-1);float2 grad=0;
        if((Pairs[i]&(1u<<a))!=0)
        {
            float2 w=Weights(i,r);grad+=w.x*(Velocity[r]-u)/CellMeters;
            div+=(w.x*u[a]+w.y*Velocity[r][a])/CellMeters;
        }
        if((Pairs[l]&(1u<<a))!=0)
        {
            float2 w=Weights(i,l);grad+=w.x*(u-Velocity[l])/CellMeters;
            div-=(w.y*Velocity[l][a]+w.x*u[a])/CellMeters;
        }
        advective+=u[a]*grad;
    }
#if RAFTSIM_PRESSURE_BOUNDARY
    div+=BoundarySource(i).x;
#endif
    float4 result=float4(advective,div,dot(u,PhysicalBedSlope[i]));Terms[i]=result;
    if(any(!isfinite(result)))InterlockedAdd(Diagnostics[1],1);
#elif RAFTSIM_PRESSURE_PHASE == 2
    float4 t=Terms[i];float2 u=Velocity[i];float divAdv=0,divRate=0;
    [unroll(2)]for(int a=0;a<2;++a)
    {
        uint r=Neighbor(i,a,1),l=Neighbor(i,a,-1);
        if((Pairs[i]&(1u<<a))!=0)
        {
            float2 w=Weights(i,r);divAdv+=(w.x*t[a]+w.y*Terms[r][a])/CellMeters;
            divRate+=WeightRate(i,r)*(u[a]-Velocity[r][a])/CellMeters;
        }
        if((Pairs[l]&(1u<<a))!=0)
        {
            float2 w=Weights(i,l);divAdv-=(w.y*Terms[l][a]+w.x*t[a])/CellMeters;
            divRate-=WeightRate(l,i)*(Velocity[l][a]-u[a])/CellMeters;
        }
    }
#if RAFTSIM_PRESSURE_BOUNDARY
    divRate+=BoundarySource(i).y;
#endif
    float q=t.z*t.z+divAdv-dot(u,GradTerms(i,2))-divRate;
    float curvature=dot(u,GradTerms(i,3))-dot(PhysicalBedSlope[i],t.xy);
    float h=Geometry[i].x,root=RaftSimPortableSqrt(h),f=NonbreakingFraction[i];
    float2 base=RaftSimPressureWet(h)?RaftSimPressureAdd(RaftSimPressureDivide(
        RaftSimPressureSub(HydroRate[i].yz,RaftSimPressureMul(u,HydroRate[i].x)),root),
        RaftSimPressureMul(t.xy,root)):0;
    // Factor depth powers to avoid needlessly underflowing h*h before a
    // finite curvature/velocity factor is applied. No depth cutoff is used.
    float p=RaftSimPortableMul(RaftSimPortableMul(f,h),RaftSimPortableMul(h,
        RaftSimPortableAdd(RaftSimPortableMul(h,q),RaftSimPortableMul(1.5,curvature))));
    float b=RaftSimPortableMul(RaftSimPortableMul(f,h),RaftSimPortableAdd(
        RaftSimPortableMul(1.5,RaftSimPortableMul(h,q)),RaftSimPortableMul(3,curvature)));
    float4 forcing=float4(RaftSimPressureMul(float2(p,b),Lengths.x),RaftSimPressureMul(float2(p,b),Lengths.y));
    Base[i]=base;Forcing[i]=forcing;
    if(any(!isfinite(base)) || any(!isfinite(forcing)))InterlockedAdd(Diagnostics[1],1);
#elif RAFTSIM_PRESSURE_PHASE == 3
    float2 c;float4 e;Coefficients(i,c,e);float w=dot(c,Base[i]);
    [unroll(2)]for(int a=0;a<2;++a)w+=e[a]*Base[Neighbor(i,a,1)][a]+e[a+2]*Base[Neighbor(i,a,-1)][a];
    float2 result=float2(w,dot(Slope(i),Base[i]));BaseW[i]=result;
    if(any(!isfinite(result)))InterlockedAdd(Diagnostics[1],1);
#elif RAFTSIM_PRESSURE_PHASE == 4
    float2 c;float4 e;Coefficients(i,c,e);
    float f=NonbreakingFraction[i],h=Geometry[i].x;float2 b=Slope(i);
    precise float2 k=c*f*BaseW[i].x+.75*f*b*BaseW[i].y;
    [unroll(2)]for(int a=0;a<2;++a)
    {
        uint r=Neighbor(i,a,1),l=Neighbor(i,a,-1);float2 nc;float4 ne;
        Coefficients(r,nc,ne);k[a]+=ne[a+2]*NonbreakingFraction[r]*BaseW[r].x;
        Coefficients(l,nc,ne);k[a]+=ne[a]*NonbreakingFraction[l]*BaseW[l].x;
    }
    float4 rhs=0;
    if(RaftSimPressureWet(h))
    {
        float root=RaftSimPortableSqrt(h);
        rhs.xy=RaftSimPressureSub(RaftSimPressureMul(k,-Lengths.x),RaftSimPressureDivide(
            RaftSimPressureAdd(GradPressure(i,0,true),RaftSimPressureMul(PhysicalBedSlope[i],Forcing[i].y)),root));
        rhs.zw=RaftSimPressureSub(RaftSimPressureMul(k,-Lengths.y),RaftSimPressureDivide(
            RaftSimPressureAdd(GradPressure(i,2,true),RaftSimPressureMul(PhysicalBedSlope[i],Forcing[i].w)),root));
    }
    RightHandSide[i]=rhs;
    if(any(!isfinite(rhs)))InterlockedAdd(Diagnostics[1],1);
#elif RAFTSIM_PRESSURE_PHASE == 5
    if(SolverDiagnostics[0]!=0 || SolverDiagnostics[1]!=0){Pressure[i]=0;return;}
    float h=Geometry[i].x,root=RaftSimPortableSqrt(h),f=NonbreakingFraction[i];
    float2 w=BaseW[i].x+WCorrection(i),b=Slope(i);
    float4 delta=Correction[i];float2 bb=BaseW[i].y+float2(dot(b,delta.xy),dot(b,delta.zw));
    float2 scaled=RaftSimPressureMul(Lengths,RaftSimPortableMul(f,root));
    float2 p=RaftSimPressureSub(Forcing[i].xz,float2(
        RaftSimPortableMul(scaled.x,RaftSimPortableMul(h,w.x)),RaftSimPortableMul(scaled.y,RaftSimPortableMul(h,w.y))));
    float2 bottomTerm=RaftSimPressureAdd(RaftSimPressureMul(w,-1.5),RaftSimPressureMul(bb,.75));
    float2 bottom=RaftSimPressureAdd(Forcing[i].yw,float2(RaftSimPortableMul(scaled.x,bottomTerm.x),RaftSimPortableMul(scaled.y,bottomTerm.y)));
    float4 result=float4(p.x,bottom.x,p.y,bottom.y);Pressure[i]=result;
    if(any(!isfinite(result)))InterlockedAdd(Diagnostics[1],1);
#elif RAFTSIM_PRESSURE_PHASE == 6
    if(SolverDiagnostics[0]!=0 || SolverDiagnostics[1]!=0){Force[i]=0;return;}
    float2 b=PhysicalBedSlope[i];float4 p=Pressure[i];
    float2 result=RaftSimPressureAdd(RaftSimPressureMul(RaftSimPressureAdd(GradPressure(i,0,false),RaftSimPressureMul(b,p.y)),-PoleWeights.x),
        RaftSimPressureMul(RaftSimPressureAdd(GradPressure(i,2,false),RaftSimPressureMul(b,p.w)),-PoleWeights.y));
    Force[i]=result;
    if(any(!isfinite(result)))InterlockedAdd(Diagnostics[1],1);
#endif
#endif
}
