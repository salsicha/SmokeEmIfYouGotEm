#include "/Engine/Public/Platform.ush"
uint Capacity;
uint NodeCount;
int3 Cells;
float3 Spacing;
StructuredBuffer<float4> Positions;
StructuredBuffer<float4> ParticleGradient;
StructuredBuffer<uint> LiveCount;
StructuredBuffer<uint> Mobility;
RWStructuredBuffer<uint> Heads;
RWStructuredBuffer<uint> Next;
RWStructuredBuffer<float4> Field;
RWStructuredBuffer<uint> Diagnostics;
static const uint Invalid=0xffffffffu;
uint Linear(int3 i) { return i.x+Cells.x*(i.y+Cells.y*i.z); }
float B2Scalar(float r) { float a=abs(r),tail=max(1.5-a,0);return a<.5?.75-r*r:.5*tail*tail; }
float3 B2(float3 r) { return float3(B2Scalar(r.x),B2Scalar(r.y),B2Scalar(r.z)); }

[numthreads(64,1,1)]
void MainCS(uint3 Id:SV_DispatchThreadID)
{
    uint i=Id.x,n=LiveCount[0];
#if STAGE==0
    if(i==0 && n>Capacity) InterlockedAdd(Diagnostics[0],n-Capacity);
    if(i>=Capacity) return;
    Next[i]=Invalid;
    if(n>Capacity || i>=n) return;
    float4 p=Positions[i],g=ParticleGradient[i];
    if(!all(isfinite(p)) || p.w<=0 || !all(isfinite(g)) || g.w!=1)
    { InterlockedAdd(Diagnostics[0],1);return; }
    float3 q=p.xyz/Spacing-.5;
    if(!all(isfinite(q)) || any(q<1) || any(q>=float3(Cells-2)))
    { InterlockedAdd(Diagnostics[1],1);return; }
    int3 bin=int3(floor(q));
    if(any(bin<1) || any(bin+2>=Cells)) { InterlockedAdd(Diagnostics[1],1);return; }
    uint old;InterlockedExchange(Heads[Linear(bin)],i,old);Next[i]=old;
    InterlockedAdd(Diagnostics[3],1);
#else
    if(i>=NodeCount) return;
    Field[i]=0;
    uint mask=Mobility[i];
    if(mask>7) { InterlockedAdd(Diagnostics[2],1);return; }
    if(n>Capacity || Diagnostics[0]!=0 || Diagnostics[1]!=0) return;
    int3 node=int3(i%Cells.x,(i/Cells.x)%Cells.y,i/(Cells.x*Cells.y));
    float3 sum=0;
    if(mask!=0)
    {
        [loop] for(int z=-2;z<2;++z) [loop] for(int y=-2;y<2;++y) [loop] for(int x=-2;x<2;++x)
        {
            // Union of the three 4x2x2 component supports: 32 bins, not64.
            if((int(x==-2 || x==1)+int(y==-2 || y==1)+int(z==-2 || z==1))>1) continue;
            int3 bin=node+int3(x,y,z);if(any(bin<0) || any(bin>=Cells)) continue;
            uint current=Heads[Linear(bin)],hops=0;
            [loop] while(current!=Invalid && hops<n)
            {
                if(current>=n) { InterlockedAdd(Diagnostics[5],1);return; }
                float3 q=Positions[current].xyz/Spacing-.5,r=float3(node)-q;
                float3 tent=max(1-abs(r),0),normal=.5*(B2(r-.5)+B2(r+.5));
                sum+=ParticleGradient[current].xyz*float3(normal.x*tent.y*tent.z,tent.x*normal.y*tent.z,tent.x*tent.y*normal.z);
                current=Next[current];++hops;
            }
            if(current!=Invalid) { InterlockedAdd(Diagnostics[5],1);return; }
        }
    }
    sum*=float3((mask&1)!=0,(mask&2)!=0,(mask&4)!=0);
    if(!all(isfinite(sum))) { InterlockedAdd(Diagnostics[2],1);return; }
    Field[i]=float4(sum,1);InterlockedAdd(Diagnostics[4],1);
#endif
}
