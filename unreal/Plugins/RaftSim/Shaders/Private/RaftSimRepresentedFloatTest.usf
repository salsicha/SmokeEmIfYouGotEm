#include "/Engine/Public/Platform.ush"
#if RAFTSIM_ARITHMETIC_PORTABLE
#include "RaftSimPortableFloat.ush"
#include "RaftSimExactHydrostatic.ush"
#include "RaftSimScaledHydrostatic.ush"
#else
#include "RaftSimRepresentedFloat.ush"
#endif
uint Count;
uint RK2;
StructuredBuffer<float4> Input;
RWStructuredBuffer<uint4> Output;
[numthreads(256,1,1)]
void MainCS(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=Count)return;
    float4 v=Input[id.x];
#if RAFTSIM_ARITHMETIC_PORTABLE
    if(RK2==4 || RK2==8)
    {
        bool2 positive;float4 result;
        if(RK2==8)result=RaftSimScaledHydrostatic(Input[4*id.x],Input[4*id.x+1],Input[4*id.x+2],Input[4*id.x+3],positive);
        else result=RaftSimExactHydrostatic(Input[4*id.x],Input[4*id.x+1],Input[4*id.x+2],Input[4*id.x+3],positive);
        Output[2*id.x]=asuint(result);Output[2*id.x+1]=uint4(positive,0,0);return;
    }
    uint result=RK2==7?asuint(RaftSimPortableMul(v.x,v.y)):RK2==6?asuint(RaftSimPortableScale(v.x,int(v.y))):RK2==5?asuint(RaftSimPortableSqrt(v.x)):RK2==3?asuint(RaftSimPortableDivide(v.x,v.y)):RK2==2?uint(RaftSimPortableValidState(v)):
        asuint(RK2==1?RaftSimPortableRK2(v.x,v.y,v.z,v.w):RaftSimPortableEuler(v.x,v.y,v.z));
    Output[id.x]=uint4(result,
        asuint(v.x),asuint(v.x+v.y*v.z),0);
#else
    Output[id.x]=uint4(asuint(RaftSimRepresentedEuler(v.x,v.y,v.z)),
        asuint(RaftSimEncodeFloat(RaftSimDecodeFloat(v.x))),asuint(v.x+v.y*v.z),0);
#endif
}
