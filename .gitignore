# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# Build artifacts
build/
dist/
*.egg-info/
# Per-host UE-linkable solver lib (rebuild via unreal/Scripts/build_solver_lib.sh)
physics/cpp/build-ue/

# Blender recovery/autosave backups are local-only.
*.blend[0-9]*
*.blend~

# Local simulation outputs
outputs/
*.telemetry.csv
pyclaw.log

# Unreal local build artifacts
unreal/Binaries/
unreal/DerivedDataCache/
unreal/Intermediate/
unreal/Plugins/*/Binaries/
unreal/Plugins/*/Intermediate/
unreal/Saved/

# Locally regenerated from installed UE sample content; never open-source redistributed.
unreal/Content/RaftSim/Environment/GeneratedLocalReview/PVEFutaleufuEuropeanBeech/
unreal/Content/RaftSim/Environment/GeneratedLocalReview/PVEFutaleufuCordilleraCypress*/

# Epic-licensed MetaHuman source/optimized assets may ship only inside cooked builds.
# The public repository retains the deterministic builders, hashes, and review reports.
unreal/Content/RaftSim/Characters/Authoring/MetaHumans/
unreal/Content/RaftSim/Characters/Production/MetaHumans/

graphify-out/

.DS_Store

# Generated diagnostic maps are regenerable and never versioned (release-1.0-plan.md P0.6)
unreal/Content/RaftSim/Maps/EnvironmentPreviews/
unreal/Content/RaftSim/Environment/GeneratedLocalReview/

# Packaged builds are release artifacts, never repo content (GitHub Releases instead)
unreal/Packaged/
*.log
