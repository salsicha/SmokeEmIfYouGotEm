--- /dev/null
+++ b/unreal/Plugins/RaftSim/Source/RaftSimWater/Public/RaftSimBreakingTransitionAnchor.h
@@ -0,0 +1,15 @@
+#pragma once
+#include "CoreMinimal.h"
+
+namespace RaftSimBreakingTransitionAnchor
+{
+// Placement-only trial. Upstream depth/Froude still determine dimensions;
+// rendering, support and foam must all receive the SAME selected origin.
+// Always select one endpoint, independent of rise sign, to avoid switching
+// origins when a small surface-rise measurement crosses zero. This is an
+// inferred representation of the transition, not surveyed crest position.
+inline int32 Select(bool bDownstreamTrial, int32 UpstreamIndex, int32 DownstreamIndex)
+{
+    return bDownstreamTrial ? DownstreamIndex : UpstreamIndex;
+}
+}
