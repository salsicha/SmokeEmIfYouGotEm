diff --git a/unreal/Plugins/RaftSim/Source/RaftSimWater/Public/RaftSimBreakingTransitionAnchor.h b/unreal/Plugins/RaftSim/Source/RaftSimWater/Public/RaftSimBreakingTransitionAnchor.h
