+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FRaftSimBreakingTransitionAnchorTest::RunTest(const FString&)
+{
+    using FAdapter = URaftSimWaterRuntimeAdapter;
+    const TArray<FVector2D> Points = {FVector2D(-5428,3607), FVector2D(-5430,3606)};
+    TestEqual(TEXT("reference keeps upstream origin"),
+        RaftSimBreakingTransitionAnchor::Select(false,0,1),0);
+    TestEqual(TEXT("trial selects downstream regardless of world axis"),
+        RaftSimBreakingTransitionAnchor::Select(true,0,1),1);
+    TestEqual(TEXT("reverse ordering does not assume downstream index is larger"),
+        RaftSimBreakingTransitionAnchor::Select(true,9,3),3);
+    const auto Dimensions = FAdapter::ComputeHydraulicCrestDimensionsMeters(.2507f,1.6658f,.3593f);
+    FAdapter::FSupportBreakingSite Site;
+    Site.RiverCoordinatesMeters=Points[RaftSimBreakingTransitionAnchor::Select(true,0,1)];
+    Site.FlowDirection=FVector2D(-.99658737651946,.08254453926251);
+    Site.PhysicalCrestHeightMeters=Dimensions.X;
+    Site.PhysicalCrestLengthMeters=Dimensions.Y;
+    Site.SpillingFraction=.9811393f;
+    Site.bLocalEnvelopeCap=true;
+    TArray<FAdapter::FSupportBreakingSite> Sites={Site};
+    float Foam=0.f;
+    const float AtAnchor=FAdapter::ComputeCoupledBreakingReliefMeters(
+        Points[1],Sites,.22f,1.f,&Foam);
+    TestTrue(TEXT("trial does not amplify the existing residual"),
+        Dimensions.X>.04 && Dimensions.X<.05 && AtAnchor<=Dimensions.X && AtAnchor>.98f*Dimensions.X);
+    TestTrue(TEXT("foam source moves with shared support crest"),Foam>.8f);
+    float UpFoam=1.f;
+    FAdapter::ComputeCoupledBreakingReliefMeters(Points[0],Sites,.22f,1.f,&UpFoam);
+    TestEqual(TEXT("upstream shooting water is not the new crest foam source"),UpFoam,0.f);
+    // Translation changes neither dimensions nor the continuous height/foam
+    // profile. These tests are representation contracts, not physical evidence.
+    const FVector2D Shift(1100.,-2100.);
+    Sites[0].RiverCoordinatesMeters+=Shift;
+    float ShiftedFoam=0.f;
+    TestTrue(TEXT("translated support and source share the same anchor"),FMath::IsNearlyEqual(
+        FAdapter::ComputeCoupledBreakingReliefMeters(Points[1]+Shift,Sites,.22f,1.f,&ShiftedFoam),AtAnchor,1.e-6f));
+    TestTrue(TEXT("translation preserves foam"),FMath::IsNearlyEqual(Foam,ShiftedFoam,1.e-6f));
+    return true;
+}
